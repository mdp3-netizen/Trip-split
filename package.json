{
  "name": "trip-kitty",
  "version": "1.0.0",
  "private": true,
  "description": "Split trip spendings with friends",
  "scripts": {
    "add:android": "cap add android",
    "add:ios": "cap add ios",
    "icons": "capacitor-assets generate --iconBackgroundColor '#0F7C86' --iconBackgroundColorDark '#0F7C86' --splashBackgroundColor '#0F7C86' --splashBackgroundColorDark '#0B1A21'",
    "sync": "cap sync",
    "android": "cap sync android && cap open android",
    "ios": "cap sync ios && cap open ios"
  },
  "dependencies": {
    "@capacitor/android": "^7.0.0",
    "@capacitor/app": "^7.0.0",
    "@capacitor/core": "^7.0.0",
    "@capacitor/ios": "^7.0.0",
    "@capacitor/share": "^7.0.0",
    "@capacitor/splash-screen": "^7.0.0"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^7.0.0"
  }
}
